# ForensicGuard Environment Configuration
# =========================================
# Copy this file to `.env` and fill in your actual Supabase project values.
# NEVER commit your actual .env file to version control.
#
# How to get these values:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project → Settings → API
#   3. Copy the "Project URL" and the "anon / public" key
#
# WARNING: Use ONLY the anon/public key. Never use the service_role key here.

# Your Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase publishable anonymous key (anon/public key only)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
